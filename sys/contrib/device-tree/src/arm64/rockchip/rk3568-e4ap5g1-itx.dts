// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Device tree for the IndiumEngine RK3568-E4AP5G1LTS-ITX server board
 * (3-SATA variant) for FreeBSD.
 *
 * Ported from the vendor Linux 6.1 sources:
 *   doc/vendor/rk3568-e4ap5g1lts-itx.dtsi
 *   doc/vendor/rk3568-e4ap5g1lts-itx-3sata.dts
 *
 * Board-specific facts carried over:
 *   - console on uart2 (ttyS2 style, 115200n8)
 *   - RK809 PMIC on i2c0 + SYR827 CPU regulator
 *   - SD (sdmmc0, cd-gpio GPIO0_A4) and eMMC (sdhci, 8-bit)
 *   - all three combinational phys in SATA mode (multiphy mux selects
 *     forced active-low by U-Boot; kept as always-on fixed regulators)
 *   - USB3 super-speed lanes disabled (dwc3 limited to high-speed)
 *   - two RGMII GMACs with Realtek PHYs
 *   - SPI NOR on sfc, PCIe3x2 slot with GPIO reset
 * FreeBSD has no VOP2/HDMI display support, so the display pipeline is
 * left out on purpose.
 */

/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/rockchip.h>
#include "rk3568.dtsi"

/ {
	model = "IndiumEngine RK3568-E4AP5G1LTS-ITX Server Board";
	compatible = "rockchip,rk3568-e4ap5g1-itx", "rockchip,rk3568";

	aliases {
		ethernet0 = &gmac0;
		ethernet1 = &gmac1;
		mmc0 = &sdmmc0;
		mmc1 = &sdhci;
		serial2 = &uart2;
	};

	chosen {
		stdout-path = "serial2:115200n8";
	};

	dc_12v: regulator-dc-12v {
		compatible = "regulator-fixed";
		regulator-name = "dc_12v";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <12000000>;
		regulator-max-microvolt = <12000000>;
	};

	vcc3v3_sys: regulator-vcc3v3-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc3v3_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		vin-supply = <&dc_12v>;
	};

	vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&dc_12v>;
	};

	vcc5v0_usb: regulator-vcc5v0-usb {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		vin-supply = <&vcc5v0_sys>;
	};

	/*
	 * GPIO-gated 5V rails feeding the USB Type-A connectors
	 * (gpio0_A5 = OTG-side jack VBUS, gpio0_A6 = host-jack VBUS),
	 * matching doc/vendor/rk3568-e4ap5g1lts-itx.dtsi.  These pins were
	 * previously recorded as "multiphy mux" placeholders that held both
	 * lines low, leaving every onboard USB port unpowered.
	 */
	vcc5v0_otg: regulator-vcc5v0-otg {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_otg";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		vin-supply = <&vcc5v0_usb>;
	};

	vcc5v0_host: regulator-vcc5v0-host {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_host";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio0 RK_PA6 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		vin-supply = <&vcc5v0_usb>;
	};

	/*
	 * Type-A socket VBUS gates on GPIO3_A0/A1 (schematic USB2_VBUS_EN /
	 * USB3_VBUS_EN).  These are the rails the vendor and Linux trees
	 * wire every usb2phy port supply to; without them the panel
	 * connectors stay unpowered no matter what the USB2PHY lane does.
	 * No pinctrl-0 here on purpose: the rockchip pinctrl nodes are not
	 * consumed by the FreeBSD fixed-regulator driver and the GPIO is
	 * driven directly.
	 */
	vcc5v0_usb2: regulator-vcc5v0-usb2 {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb2";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio3 RK_PA0 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};

	vcc5v0_usb3: regulator-vcc5v0-usb3 {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_usb3";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&gpio3 RK_PA1 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};
};

/*
 * All three combinational phys enabled (SATA lanes are not used by the
 * FreeBSD bring-up; combphy0/1 keep USB3, combphy2 is idle/PCIe).
 */
&combphy0 {
	status = "okay";
};

&combphy1 {
	status = "okay";
};

&combphy2 {
	status = "okay";
};

/*
 * SATA disabled for FreeBSD NFS bring-up: the dwc-ahci probe of
 * sata@fc400000 (sata1) triggers an SoC external abort (esr 0xbe000011)
 * during channel init, before NFS root mounts.  The bring-up targets are
 * NFS root over gmac1 and the PCIe x4 slot (EHCI card + RTL8188EU),
 * neither of which needs SATA.  Re-enable once the AHCI abort is fixed.
 */
&sata0 {
	status = "disabled";
};

&sata1 {
	status = "disabled";
};

&sata2 {
	status = "disabled";
};

/*
 * USB3 super-speed lanes are muxed to SATA on this board, so both dwc3
 * controllers are limited to USB 2.0 high speed.
 */
&usb_host0_xhci {
	dr_mode = "host";
	phys = <&usb2phy0_otg>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";
	status = "okay";
};

&usb_host1_xhci {
	phys = <&usb2phy0_host>;
	phy-names = "usb2-phy";
	maximum-speed = "high-speed";
	status = "okay";
};

&gmac0 {
	assigned-clocks = <&cru SCLK_GMAC0_RX_TX>, <&cru SCLK_GMAC0>;
	assigned-clock-parents = <&cru SCLK_GMAC0_RGMII_SPEED>;
	assigned-clock-rates = <0>, <125000000>;

	clock_in_out = "output";
	phy-handle = <&rgmii_phy0>;
	phy-mode = "rgmii";
	pinctrl-names = "default";
	pinctrl-0 = <&gmac0_miim
		     &gmac0_tx_bus2
		     &gmac0_rx_bus2
		     &gmac0_rgmii_clk
		     &gmac0_rgmii_bus>;
	snps,reset-gpio = <&gpio2 RK_PB1 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	tx_delay = <0x4f>;
	rx_delay = <0x26>;
	/*
	 * Fixed board MACs (U-Boot ethaddr convention: gmac0 = f6:dc:54:d8:f1:a6,
	 * gmac1 = ethaddr+4 = fa:dc:54:d8:f1:a6).  The eqos driver reads these
	 * from DT because the U-Boot-written MAC is lost on GMAC soft reset.
	 */
	local-mac-address = [f6 dc 54 d8 f1 a6];
	status = "okay";
};

&gmac1 {
	assigned-clocks = <&cru SCLK_GMAC1_RX_TX>, <&cru SCLK_GMAC1>;
	assigned-clock-parents = <&cru SCLK_GMAC1_RGMII_SPEED>;
	assigned-clock-rates = <0>, <125000000>;

	clock_in_out = "output";
	pinctrl-names = "default";
	pinctrl-0 = <&gmac1m0_miim
		     &gmac1m0_tx_bus2
		     &gmac1m0_rx_bus2
		     &gmac1m0_rgmii_clk
		     &gmac1m0_rgmii_bus
		     &gmac1m0_clkinout>;
	phy-handle = <&rgmii_phy1>;
	phy-mode = "rgmii-rxid";
	snps,reset-gpio = <&gpio3 RK_PC2 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 20000 100000>;
	/*
	 * NFS root boots over gmac1.  FreeBSD's rgephy does not program the
	 * PHY's RGMII delays, so unlike Linux (which sets the PHY-side RX
	 * delay for "rgmii-rxid"), the MAC-side GRF delays must carry the
	 * timing.  Use the values Linux boots with on this board
	 * (tx_delay=0x3c, rx_delay=0x03); rx_delay=0x00 left RX with CRC
	 * errors ("Receive error rdes3=...RE") and the NFS mount stalled.
	 */
	tx_delay = <0x3c>;
	rx_delay = <0x03>;
	status = "okay";
	local-mac-address = [fa dc 54 d8 f1 a6];
};

&mdio0 {
	rgmii_phy0: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

&mdio1 {
	rgmii_phy1: phy@1 {
		compatible = "ethernet-phy-ieee802.3-c22";
		reg = <0x1>;
	};
};

&i2c0 {
	status = "okay";

	vdd_cpu: regulator@40 {
		compatible = "silergy,syr827";
		reg = <0x40>;
		fcs,suspend-voltage-selector = <1>;
		regulator-name = "vdd_cpu";
		regulator-min-microvolt = <800000>;
		regulator-max-microvolt = <1150000>;
		regulator-ramp-delay = <2300>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};

	rk809: pmic@20 {
		compatible = "rockchip,rk809";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA3 IRQ_TYPE_LEVEL_LOW>;
		#clock-cells = <1>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int>;
		system-power-controller;
		vcc1-supply = <&vcc3v3_sys>;
		vcc2-supply = <&vcc3v3_sys>;
		vcc3-supply = <&vcc3v3_sys>;
		vcc4-supply = <&vcc3v3_sys>;
		vcc5-supply = <&vcc3v3_sys>;
		vcc6-supply = <&vcc3v3_sys>;
		vcc7-supply = <&vcc3v3_sys>;
		vcc8-supply = <&vcc3v3_sys>;
		vcc9-supply = <&vcc3v3_sys>;
		wakeup-source;

		regulators {
			vdd_logic: DCDC_REG1 {
				regulator-name = "vdd_logic";
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;
			};

			vdd_gpu: DCDC_REG2 {
				regulator-name = "vdd_gpu";
				regulator-initial-mode = <0x2>;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-always-on;
				regulator-boot-on;
				regulator-initial-mode = <0x2>;
			};

			vdd_npu: DCDC_REG4 {
				regulator-name = "vdd_npu";
				regulator-initial-mode = <0x2>;
				regulator-min-microvolt = <500000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;
			};

			vcc_1v8: DCDC_REG5 {
				regulator-name = "vcc_1v8";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			vdda0v9_image: LDO_REG1 {
				regulator-name = "vdda0v9_image";
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
			};

			vdda_0v9: LDO_REG2 {
				regulator-name = "vdda_0v9";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
			};

			vdda0v9_pmu: LDO_REG3 {
				regulator-name = "vdda0v9_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <900000>;
				regulator-max-microvolt = <900000>;
			};

			vccio_acodec: LDO_REG4 {
				regulator-name = "vccio_acodec";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			vccio_sd: LDO_REG5 {
				regulator-name = "vccio_sd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
			};

			vcc3v3_pmu: LDO_REG6 {
				regulator-name = "vcc3v3_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
			};

			vcca_1v8: LDO_REG7 {
				regulator-name = "vcca_1v8";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			vcca1v8_pmu: LDO_REG8 {
				regulator-name = "vcca1v8_pmu";
				regulator-always-on;
				regulator-boot-on;
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			vcca1v8_image: LDO_REG9 {
				regulator-name = "vcca1v8_image";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <1800000>;
			};

			vcc_3v3: SWITCH_REG1 {
				regulator-name = "vcc_3v3";
				regulator-always-on;
				regulator-boot-on;
			};

			vcc3v3_sd: SWITCH_REG2 {
				regulator-name = "vcc3v3_sd";
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

&pcie30phy {
	status = "okay";
};

&pcie3x2 {
	pinctrl-names = "default";
	pinctrl-0 = <&pcie_reset_pin>;
	reset-gpios = <&gpio2 RK_PD6 GPIO_ACTIVE_HIGH>;
	/*
	 * Override the pcie3x2 ranges to expose only IO + 32-bit MEM.
	 * The MCS9990 PCIe-to-USB card has 32-bit BARs; with the upstream
	 * MEM64 range FreeBSD assigns its BARs into the 64-bit window and the
	 * resulting bus-space mapping comes out unaligned, so EHCI/OHCI MMIO
	 * accesses fault on arm64 ("Misaligned access").  Restricting to
	 * 32-bit MEM (0xf0200000-0xf3e00000) keeps BARs in the aligned
	 * direct-mapped window.
	 */
	ranges = <0x01000000 0x0 0xf0100000 0x0 0xf0100000 0x0 0x00100000>,
		 <0x02000000 0x0 0xf0200000 0x0 0xf0200000 0x0 0x01e00000>;
	status = "okay";
};

/*
 * PCIe 2.0 x1 M.2 22110 slot (SM2263EN NVMe).  PERST# on GPIO3_PC1,
 * GPIO_ACTIVE_HIGH matches the Linux board DTB (assert = pin low).
 * combphy2 is muxed to PCIe here (sata2 is disabled below); the dtsi
 * ships pcie2x1 with status="disabled", so this override is what brings
 * the second controller up.
 *
 * Override the dtsi ranges to expose only IO + 32-bit MEM.  The upstream
 * third range (64-bit MEM: PCI 0x40000000 -> CPU 0x3_00000000) makes
 * FreeBSD assign the SM2263EN's 64-bit BAR at PCI 0x40000000, which the
 * root port cannot forward (MEM32 window tops out below 4GB; the
 * prefetchable window is never programmed), so all BAR MMIO reads return
 * 0xFF.  The garbage CAP then yields MPSMIN=15 -> page_size 2^27 ->
 * (page_size/8)*page_size overflows to 0 -> nvme max_xfer_size=0 and
 * identify fails ("len (4096) exceeds max_xfer_size (0)").  Restricting
 * to the 32-bit MEM window (same fix as pcie3x2 above) keeps the BAR
 * below 4GB where the bridge window and iATU view both work.
 */
&pcie2x1 {
	reset-gpios = <&gpio3 RK_PC1 GPIO_ACTIVE_HIGH>;
	ranges = <0x01000000 0x0 0xf4100000 0x0 0xf4100000 0x0 0x00100000>,
		 <0x02000000 0x0 0xf4200000 0x0 0xf4200000 0x0 0x01e00000>;
	status = "okay";
};

&pinctrl {
	pcie {
		pcie_reset_pin: pcie-reset-pin {
			rockchip,pins = <2 RK_PD6 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pmic {
		pmic_int: pmic-int {
			rockchip,pins = <0 RK_PA3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&pmu_io_domains {
	pmuio1-supply = <&vcc3v3_pmu>;
	pmuio2-supply = <&vcc3v3_pmu>;
	vccio1-supply = <&vccio_acodec>;
	vccio2-supply = <&vcc_1v8>;
	vccio3-supply = <&vccio_sd>;
	vccio4-supply = <&vcc_1v8>;
	vccio5-supply = <&vcc_3v3>;
	vccio6-supply = <&vcc_1v8>;
	vccio7-supply = <&vcc_3v3>;
	status = "okay";
};

&saradc {
	vref-supply = <&vcca_1v8>;
	status = "okay";
};

&sdhci {
	bus-width = <8>;
	max-frequency = <52000000>;
	non-removable;
	pinctrl-names = "default";
	pinctrl-0 = <&emmc_bus8 &emmc_clk &emmc_cmd &emmc_datastrobe>;
	status = "okay";
};

&sdmmc0 {
	bus-width = <4>;
	cap-sd-highspeed;
	cd-gpios = <&gpio0 RK_PA4 GPIO_ACTIVE_LOW>;
	disable-wp;
	pinctrl-names = "default";
	pinctrl-0 = <&sdmmc0_bus4 &sdmmc0_clk &sdmmc0_cmd &sdmmc0_det>;
	sd-uhs-sdr104;
	vmmc-supply = <&vcc3v3_sd>;
	vqmmc-supply = <&vccio_sd>;
	status = "okay";
};

&sfc {
	pinctrl-0 = <&fspi_pins>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <24000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <1>;
		vcc-supply = <&vcc_3v3>;
	};
};

&tsadc {
	status = "okay";
};

&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

&usb2phy0 {
	status = "okay";
};

/* Supply wiring mirrors the vendor/Linux tree: the GPIO3_A0 rail feeds
 * every Type-A lane except the otg jack, which is on GPIO3_A1. */
&usb2phy0_host {
	phy-supply = <&vcc5v0_usb2>;
	status = "okay";
};

&usb2phy0_otg {
	phy-supply = <&vcc5v0_usb3>;
	status = "okay";
};

&usb2phy1 {
	status = "okay";
};

&usb2phy1_host {
	phy-supply = <&vcc5v0_usb2>;
	status = "okay";
};

&usb2phy1_otg {
	phy-supply = <&vcc5v0_usb2>;
	status = "okay";
};

&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

&usb_host1_ehci {
	status = "okay";
};

&usb_host1_ohci {
	status = "okay";
};
